;; raylib - classic game: missile commander
;;
;; Sample game developed by Marc Palau and Ramon Santamaria.
;; Copyright (c) 2015 Ramon Santamaria (@raysan5), zlib license.
;;
;; Ported to Atmos: an altered version of `classics/src/missile_commander.c`
;; of raysan5/raylib-games. The game is the same; `gameOver`, `pause`, and
;; the `active` flags of the missiles, the interceptors and the explosions
;; became tasks. Relaxed (doc/fidelity.md): the slots of the C are gone.

include "classic.atm"

val W, H   = 800, 450
val f32    = ray.f32
val GAP    = W // 10            ;; between launchers and buildings
val EXPLOSION_COLOR = ray.color(125, 125, 125, 125)

ray.window [title="classic game: missile commander", width=W, height=H, fps=60]

;; The speed toward a target, as the C: a module on doubles, kept in a float.
func toward (ox, oy, tx, ty, speed) {
    val m = f32(math.sqrt(math.pow(f32(tx - ox), 2) + math.pow(f32(ty - oy), 2)))
    return f32(f32(f32(tx - ox) * speed) / m), f32(f32(f32(ty - oy) * speed) / m)
}

;; An explosion: grows for 90 frames, shrinks until frame 210, and ends. It
;; grows on `:grow`, which comes after the missiles in each frame; it is
;; drawn by `Play`.
task Explosion (x, y) {
    set pub = [x=x, y=y, mult=0]
    loop f in (1, 210) {
        await :grow
        set pub.mult = if f <= 90 => f32(f/90) => f32(1 - f32(f32(f - 90)/210))
    }
    await :grow
}

;; An interceptor: flies from its launcher to the click, and explodes there.
task Interceptor (g, booms, l, tx, ty) {
    val sx, sy = toward(l.x, l.y, tx, ty, 10)
    var x, y = l.x, l.y
    par :any {
        loop on :frame {
            set x, y = f32(x + sx), f32(y + sy)
            until f32(math.sqrt(math.pow(f32(x - tx), 2) + math.pow(f32(y - ty), 2))) < 10
        }
    } with {
        loop on :draw {
            ray.line(l.x, l.y, x, y, ray.GREEN)
            if (g.frames % 16) < 8 {
                ray.circle(x, y, 3, ray.BLUE)
            }
        }
    }
    spawn @booms Explosion(x, y)
}

;; A missile: falls toward its target, and ends below the screen, on a
;; launcher or a building (which it destroys), or in an explosion (which
;; scores). Where it ends, it explodes.
task Missile (g, booms) {
    val ox, oy = ray.random(20, W - 20), -10
    val tx, ty = ray.random(20, W - 20), H + 10
    val sx, sy = toward(ox, oy, tx, ty, 1)
    var x, y = ox, oy
    var hit = false
    par :any {
        loop on :frame {
            set x, y = f32(x + sx), f32(y + sy)
            until y > H
            val l = loop _,l in g.launchers {
                if l.on && ray.check_collision_point_rec(x, y, l.x - 40, l.y - 40, 80, 80) { break l }
            }
            val b = loop _,b in g.buildings {
                if b.on && ray.check_collision_point_rec(x, y, b.x - 30, b.y - 30, 60, 60) { break b }
            }
            val e = loop _,e in booms {
                if ray.check_collision_point_circle(x, y, e.pub.x, e.pub.y, f32(40*e.pub.mult)) { break e }
            }
            if l { set l.on, hit = false, true }
            if b { set b.on, hit = false, true }
            if e { set g.score, hit = g.score + 100, true }
            until hit
        }
    } with {
        loop on :draw {
            ray.line(ox, oy, x, y, ray.RED)
            if (g.frames % 16) < 8 {
                ray.circle(x, y, 3, ray.YELLOW)
            }
        }
    }
    if hit {
        spawn @booms Explosion(x, y)
    }
}

;; One game: its state is made anew, and it ends when no launcher or no
;; building is left.
;;
;; In each frame, in the order of the C: the frames played, the
;; interceptors, the missiles, the explosions, the outgoing and the incoming
;; fire. Drawn in the order of the C: the missiles, the interceptors, the
;; explosions, the launchers and buildings, the score.
task Play () {
    pin g = [score=0, frames=0, launchers=[], buildings=[]]
    loop _,x in [GAP*1, GAP*5, GAP*9] {
        vector.insert(g.launchers, [x=x, y=H-40, on=true])
    }
    loop _,i in [2, 3, 4, 6, 7, 8] {
        vector.insert(g.buildings, [x=GAP*i, y=H-30, on=true])
    }
    pin booms = tasks()
    pin interceptors = tasks()
    pin missiles = tasks()

    spawn {
        loop on :frame {
            set g.frames += 1
        }
    }
    spawn {
        loop on :frame {
            emit :grow
            ;; outgoing fire: a click fires from the launcher of its button
            var n = 0
            if ray.mouse_pressed(0) { set n = 1 }
            if ray.mouse_pressed(2) { set n = 2 }
            if ray.mouse_pressed(1) { set n = 3 }
            if (n > 0) && (g.launchers@(n-1)).on {
                spawn @interceptors Interceptor(g, booms, g.launchers@(n-1), ray.mouse_x(), ray.mouse_y())
            }
            ;; incoming fire: a missile every 80 frames played
            if (g.frames % 80) == 0 {
                spawn @missiles Missile(g, booms)
            }
        }
    }
    spawn {
        loop on :draw {
            loop _,e in booms {
                ray.circle(e.pub.x, e.pub.y, f32(40*e.pub.mult), EXPLOSION_COLOR)
            }
            loop _,l in g.launchers {
                if l.on { ray.rectangle(l.x - 40, l.y - 40, 80, 80, ray.GRAY) }
            }
            loop _,b in g.buildings {
                if b.on { ray.rectangle(b.x - 30, b.y - 30, 60, 60, ray.LIGHTGRAY) }
            }
            ray.text(string.format("SCORE %4d", g.score), 20, 20, 40, ray.LIGHTGRAY)
        }
    }
    ;; [trace] of the test mode: one line per frame of a game, after its logic
    spawn {
        if ray.frame() > 0 {
            loop on :draw {
                print(string.format("%d %s %d %d %d", ray.frame(), phase, g.score, g.frames, #missiles))
            }
        }
    }
    ;; [/trace]
    loop on :frame {
        val l = loop _,x in g.launchers { until x.on }
        val b = loop _,x in g.buildings { until x.on }
        until !l || !b
    }
}

;; [trace] of the test mode: the frames out of a game
spawn {
    if ray.frame() > 0 {
        loop on :draw {
            if phase == :over {
                print(string.format("%d %s", ray.frame(), phase))
            }
        }
    }
}
;; [/trace]

await Classic(Play)
