;; raylib - classic game: asteroids survival
;;
;; Sample game developed by Ian Eito, Albert Martos and Ramon Santamaria.
;; Copyright (c) 2015 Ramon Santamaria (@raysan5), zlib license.
;;
;; Ported to Atmos: an altered version of `classics/src/asteroids_survival.c`
;; of raysan5/raylib-games. The game is the same; its control is written as
;; sequences: `gameOver` and `pause` of the C became tasks and a mute.

include "classic.atm"

val W, H    = 800, 450
val DEG2RAD = 3.14159265358979323846 / 180
val BASE    = 20                ;; PLAYER_BASE_SIZE
val SPEED   = 6                 ;; PLAYER_SPEED
val SHIP_H  = (BASE/2) / ray.tanf(20*DEG2RAD)
val WX, HY  = W + SHIP_H, H + SHIP_H     ;; beyond the borders

ray.window [title="classic game: asteroids survival", width=W, height=H, fps=60]

pin var ship = [x=0, y=0, rot=0, acc=0, cx=0, cy=0]
var time = 0                    ;; frames survived: the score

;; The collider, a circle ahead of the center, as in the C (sin and cos on
;; doubles, stored in floats).
func collider () {
    val a = ship.rot * DEG2RAD
    set ship.cx = ship.x + (math.sin(a) * (SHIP_H/2.5))
    set ship.cy = ship.y - (math.cos(a) * (SHIP_H/2.5))
}

task Ship () {
    par {
        loop on :frame {
            if ray.key_down('LEFT')  { set ship.rot -= 5 }
            if ray.key_down('RIGHT') { set ship.rot += 5 }
            val a  = ship.rot * DEG2RAD
            val sx = math.sin(a) * SPEED
            val sy = math.cos(a) * SPEED
            if ray.key_down('UP') {
                if ship.acc < 1 { set ship.acc = ship.acc + 0.04 }
            } else {
                ifs {
                    ship.acc > 0 => { set ship.acc = ship.acc - 0.02 }
                    ship.acc < 0 => { set ship.acc = 0 }
                }
            }
            if ray.key_down('DOWN') {
                ifs {
                    ship.acc > 0 => { set ship.acc = ship.acc - 0.04 }
                    ship.acc < 0 => { set ship.acc = 0 }
                }
            }
            set ship.x = ship.x + (sx * ship.acc)
            set ship.y = ship.y - (sy * ship.acc)
            ifs {
                ship.x > WX      => { set ship.x = -SHIP_H }
                ship.x < -SHIP_H => { set ship.x = WX }
            }
            ifs {
                ship.y > HY      => { set ship.y = -SHIP_H }
                ship.y < -SHIP_H => { set ship.y = HY }
            }
            collider()
        }
    } with {
        loop on :draw {
            val a = ship.rot * DEG2RAD
            val s, c = ray.sinf(a), ray.cosf(a)
            ray.triangle(ship.x + (s*SHIP_H), ship.y - (c*SHIP_H),
                        ship.x - (c*(BASE/2)), ship.y - (s*(BASE/2)),
                        ship.x + (c*(BASE/2)), ship.y + (s*(BASE/2)), ray.MAROON)
        }
    }
}

;; A meteor: ends the game when it touches the ship, which moved before it;
;; then moves, across the borders.
task Meteor (game, m, r, color) {
    par {
        loop on :frame {
            if ray.check_collision_circles(ship.cx, ship.cy, 12, m.x, m.y, r) {
                emit @game :over
            }
            set m.x += m.vx
            set m.y += m.vy
            ifs {
                m.x > (W + r) => { set m.x = -r }
                m.x < (0 - r) => { set m.x = W + r }
            }
            ifs {
                m.y > (H + r) => { set m.y = -r }
                m.y < (0 - r) => { set m.y = H + r }
            }
        }
    } with {
        loop on :draw {
            ray.circle_v(m.x, m.y, r, color)
        }
    }
}

;; One game: ends when a meteor touches the ship.
task Play () {
    set ship = [x=W//2, y=(H//2) - (SHIP_H/2), rot=0, acc=0, cx=0, cy=0]
    collider()
    set time = 0

    ;; The meteors start out of the center. As in the C, `ok` is not reset
    ;; after the speeds, so only the first one checks its x.
    var ok = false
    pin meteor = func () {
        var x = ray.random(0, W)
        loop {
            until ok
            if (x > ((W//2) - 150)) && (x < ((W//2) + 150)) {
                set x = ray.random(0, W)
            } else {
                set ok = true
            }
        }
        set ok = false
        var y = ray.random(0, H)
        loop {
            until ok
            if (y > ((H//2) - 150)) && (y < ((H//2) + 150)) {
                set y = ray.random(0, H)
            } else {
                set ok = true
            }
        }
        set ok = false
        var vx = ray.random(-2, 2)
        var vy = ray.random(-2, 2)
        loop {
            until ok
            if (vx == 0) && (vy == 0) {
                set vx = ray.random(-2, 2)
                set vy = ray.random(-2, 2)
            } else {
                set ok = true
            }
        }
        [x=x, y=y, vx=vx, vy=vy]
    }

    spawn {
        ;; the time survived, counted first in each frame, as in the C
        loop on :frame {
            set time += 1
        }
    }
    spawn Ship()
    pin meteors = tasks()
    loop in 8 {
        spawn @meteors Meteor(task, meteor(), 20, ray.GRAY)
    }
    loop in 16 {
        spawn @meteors Meteor(task, meteor(), 10, ray.DARKGRAY)
    }
    spawn {
        loop on :draw {
            ray.text(string.format("TIME: %.02f", time/60), 10, 10, 20, ray.BLACK)
        }
    }
    await :over
}

;; [trace] of the test mode: one line per frame, after its logic
spawn {
    if ray.frame() > 0 {
        loop on :draw {
            print(string.format("%d %s %.6f %.6f %.0f %.6f %d", ray.frame(), phase,
                ship.x, ship.y, ship.rot, ship.acc, time))
        }
    }
}
;; [/trace]

await Classic(Play)
