;; raylib - classic game: space invaders
;;
;; Sample game developed by Ian Eito, Albert Martos and Ramon Santamaria.
;; Copyright (c) 2015 Ramon Santamaria (@raysan5), zlib license.
;;
;; Ported to Atmos: an altered version of `classics/src/space_invaders.c` of
;; raysan5/raylib-games. The game is the same; its control is written as
;; sequences: `gameOver`, `pause`, `wave`, `smooth`, `victory`, `shootRate`,
;; and the `active` flags of the C became tasks, awaits, and a mute.

include "classic.atm"

val W, H   = 800, 450

ray.window [title="classic game: space invaders", width=W, height=H, fps=60]

func overlap (a, aw, ah, b, bw, bh) {
    ray.check_collision_recs(a.x, a.y, aw, ah, b.x, b.y, bw, bh)
}

func respawn (e) {
    set e.x = ray.random(W, W + 1000)
    set e.y = ray.random(0, H - 10)
}

;; An enemy: joins the game with its wave; then, in each frame, ends the
;; game when it touches the player (who moved, and is not yet back inside
;; the screen), moves left, and comes back from the right.
task Enemy (g, game, i, e) {
    await :frame until #g.enemies > i
    par {
        loop {
            if overlap(g.player, 20, 20, e, 10, 10) {
                emit @game :over
            }
            set e.x -= 5
            if e.x < 0 {
                respawn(e)
            }
            await :frame
        }
    } with {
        loop on :draw {
            ray.rectangle_v(e.x, e.y, 10, 10, ray.GRAY)
        }
    }
}

;; A shot: a slot that waits to be fired, flies, and is free again. The
;; first free slot takes the request of the gun, and moves at once, in the
;; order of the slots, as in the C. In each frame it checks every enemy in
;; order, even after a hit: one shot may take more than one enemy.
task Shot (g, game) {
    par {
        loop {
            set pub = nil
            await :frame until g.fire
            set pub = g.fire
            set g.fire = nil
            loop {
                set pub.x += 7
                var done = (pub.x + 10) >= W
                loop _,en in g.enemies {
                    if overlap(pub, 10, 5, en, 10, 10) {
                        respawn(en)
                        set g.score += 100
                        emit @game :killed
                        set done = true
                    }
                }
                if done {
                    emit @game :rearm
                }
                until done
                await :frame
            }
        }
    } with {
        loop on :draw {
            if pub {
                ray.rectangle_v(pub.x, pub.y, 10, 5, ray.MAROON)
            }
        }
    }
}

;; One game: three waves, then the last one goes on. Ends when an enemy
;; touches the g.player.
;;
;; The tasks are spawned in the order of the C, which here is also the order
;; of the drawing: the waves, the player, the g.enemies, the player back inside
;; the screen, the gun, the shots, the g.score.
task Play () {
    ;; its state: the player (20x20), the 50 enemies of the game, which its
    ;; waves take in order, the enemies in play, in order ([x=,y=], 10x10),
    ;; the score, and the shot that the gun asks of the first free slot
    pin g = [player=[x=20, y=50], all=[], enemies=[], score=0, fire=nil]
    loop i in 50 {
        val x = ray.random(W, W + 1000)
        val y = ray.random(0, H - 10)
        set g.all@i = [x=x, y=y]
    }
    var title, alpha = "", 0

    spawn {
        loop on :draw {
            ray.rectangle_v(g.player.x, g.player.y, 20, 20, ray.BLACK)
            ray.text(title, (W//2) - (ray.measure(title,40)//2), (H//2) - 40, 40, ray.fade(ray.BLACK, alpha))
        }
    }
    spawn {
        ;; the waves: the title fades in and out; a wave ends at the start of
        ;; the frame that finds its number of kills (relaxed: the C compares with
        ;; `==`, so two kills in one frame at its end would keep the wave forever)
        var kills = 0
        spawn {
            loop on :killed {
                set kills += 1
            }
        }
        loop _,w in [[10,"FIRST WAVE"], [20,"SECOND WAVE"], [50,"THIRD WAVE"]] {
            val n = w@0
            set title, alpha, kills = w@1, 0, 0
            loop i in (#g.enemies, n-1) {
                vector.insert(g.enemies, g.all@i)
            }
            par :any {
                loop on :frame {
                    set alpha = alpha + 0.02
                    until alpha >= 1
                }
                set alpha = alpha - 0.02
                loop on :frame {
                    set alpha = alpha - 0.02
                }
            } with {
                await :frame until kills >= n
                if n == 50 {
                    emit :victory
                    await false
                }
            }
        }
    }
    spawn {
        loop on :frame {
            if ray.key_down('RIGHT') { set g.player.x += 5 }
            if ray.key_down('LEFT')  { set g.player.x -= 5 }
            if ray.key_down('UP')    { set g.player.y -= 5 }
            if ray.key_down('DOWN')  { set g.player.y += 5 }
        }
    }
    pin ens = tasks()
    loop i in 50 {
        spawn @ens Enemy(g, task, i, g.all@i)
    }
    spawn {
        ;; the player back inside the screen, after the g.enemies
        loop on :frame {
            if g.player.x <= 0 { set g.player.x = 0 }
            if (g.player.x + 20) >= W { set g.player.x = W - 20 }
            if g.player.y <= 0 { set g.player.y = 0 }
            if (g.player.y + 20) >= H { set g.player.y = H - 20 }
        }
    }
    spawn {
        ;; the gun: a shot every 4 frames with SPACE held, counted again
        ;; after a shot hits or leaves the screen
        loop {
            watching :rearm {
                loop {
                    loop in 4 {
                        await :frame until ray.key_down('SPACE')
                    }
                    set g.fire = [x=g.player.x, y=g.player.y + 5]
                }
            }
        }
    }
    pin shots = tasks(50)
    loop in 50 {
        spawn @shots Shot(g, task)
    }
    spawn {
        par {
            loop on :draw {
                ray.text(string.format("%04d", g.score), 20, 20, 40, ray.GRAY)
            }
        } with {
            await :victory
            val s = "YOU WIN"
            loop on :draw {
                ray.text(s, (W//2) - (ray.measure(s,40)//2), (H//2) - 40, 40, ray.BLACK)
            }
        }
    }
    ;; [trace] of the test mode: one line per frame of a game, after its logic
    spawn {
        if ray.frame() > 0 {
            loop on :draw {
                print(string.format("%d %s %.0f %.0f %d %d", ray.frame(), phase, g.player.x, g.player.y, #g.enemies, g.score))
            }
        }
    }
    ;; [/trace]
    await :over
}

;; [trace] of the test mode: the frames out of a game
spawn {
    if ray.frame() > 0 {
        loop on :draw {
            if phase == :over {
                print(string.format("%d %s", ray.frame(), phase))
            }
        }
    }
}
;; [/trace]

await Classic(Play)
