;; raylib - classic game: gorilas
;;
;; Sample game developed by Marc Palau and Ramon Santamaria.
;; Copyright (c) 2015 Ramon Santamaria (@raysan5), zlib license.
;;
;; Ported to Atmos: an altered version of `classics/src/gorilas.c` of
;; raysan5/raylib-games. The game is the same; its control is written as
;; sequences: `gameOver`, `pause`, `ballOnAir`, `ball.active`, and the
;; `active` flags of the explosions of the C became tasks, awaits, and a
;; toggle.

include "classic.atm"

val W, H    = 800, 450
val f32     = ray.f32
val PI      = f32(3.14159265358979323846)
val DEG2RAD = f32(PI/180)
val RAD2DEG = f32(180/PI)
val GRAVITY = f32(f32(9.81)/60)

ray.window [title="classic game: gorilas", width=W, height=H, fps=60]

;; As in the C, the turn outlives a game: the next game starts with the
;; team after the one that won.
var turn = 0

;; The aim follows the mouse, above the player and toward the other team;
;; true on a click.
func aim (g, p) {
    val mx, my = ray.mouse_x(), ray.mouse_y()
    if (my <= p.y) && (if p.left => (mx >= p.x) => (mx <= p.x)) {
        set p.power = math.floor(math.sqrt(math.pow(f32(p.x - mx), 2) + math.pow(f32(p.y - my), 2)))
        set p.angle = math.floor(ray.asin(f32(f32(p.y - my) / p.power)) * RAD2DEG)
        set p.ax, p.ay = mx, my
        if ray.mouse_pressed(0) {
            set p.px, p.py, p.ppower, p.pangle = p.ax, p.ay, p.power, p.angle
            set g.ball.x, g.ball.y = p.x, p.y
            return true
        }
    } else {
        set p.ax, p.ay, p.power, p.angle = p.x, p.y, 0, 0
    }
    false
}

;; One frame of the ball: :miss, :hit (a player), :boom (a building), or nil
;; while it flies. As in the C, it goes through its own player and through
;; the explosions.
func fly (g) {
    val ball = g.ball
    set ball.x, ball.y = f32(ball.x + ball.sx), f32(ball.y + ball.sy)
    set ball.sy = f32(ball.sy + GRAVITY)
    ifs {
        (ball.x + 10) < 0 => :miss
        (ball.x - 10) > W => :miss
        else => do :fly {
            loop i,p in g.players {
                if ray.check_collision_circle_rec(ball.x, ball.y, 10, p.x - 20, p.y - 20, 40, 40) {
                    if i == turn {
                        escape :fly, nil
                    }
                    set p.alive = false
                    escape :fly, :hit
                }
            }
            loop _,e in g.explosions {
                if ray.check_collision_circles(ball.x, ball.y, 10, e.x, e.y, 20) {
                    escape :fly, nil
                }
            }
            loop _,b in g.buildings {
                if ray.check_collision_circle_rec(ball.x, ball.y, 10, b.x, b.y, b.w, b.h) {
                    vector.insert(g.explosions, [x=ball.x, y=ball.y + 10])
                    escape :fly, :boom
                }
            }
            nil
        }
    }
}

;; One game: turns until a team is gone. Its state is made anew.
task Play () {
    pin g = [buildings=[], explosions=[], ball=[x=0, y=0, sx=0, sy=0],
             players=[[left=true, alive=true], [left=false, alive=true]]]
    ;; the buildings: a width, a height, and a gray, each from the left
    val mean = f32(f32(W/15) + 1)
    var x = 0
    loop _ in 15 {
        val w = ray.random(math.floor(f32(f32(f32(mean*85)/100) + 1)), math.floor(f32(f32(mean*130)/100)))
        val h = ray.random(20, 60)
        val c = ray.random(120, 200)
        vector.insert(g.buildings, [x=x, y=H - ((H*h)//100), w=w, h=((H*h)//100) + 1, gray=c])
        set x += w
    }
    ;; the players, on top of the building under each, near each side
    loop _,p in g.players {
        val x = if p.left => ray.random(40, 160) => (W - ray.random(40, 160))
        var b = g.buildings@(#g.buildings - 1)        ;; or the last, if beyond it
        loop _,c in g.buildings {
            if (c.x + c.w) > x {
                set b = c
                break
            }
        }
        set p.x, p.y = f32(b.x + (b.w/2)), b.y - 20
        set p.ax, p.ay, p.px, p.py = p.x, p.y, p.x, p.y
        set p.power, p.angle, p.ppower, p.pangle = 0, 0, 0, 0
    }

    spawn {
        loop on :draw {
            loop _,b in g.buildings {
                ray.rectangle_v(b.x, b.y, b.w, b.h, ray.color(b.gray, b.gray, b.gray, 255))
            }
            loop _,e in g.explosions {
                ray.circle(e.x, e.y, 30, ray.RAYWHITE)
            }
            loop _,p in g.players {
                if p.alive {
                    ray.rectangle(p.x - 20, p.y - 20, 40, 40, if p.left => ray.BLUE => ray.RED)
                }
            }
        }
    }

    ;; [trace] of the test mode: one line per frame of a game, after its logic
    spawn {
        if ray.frame() > 0 {
            loop on :draw {
                val p0, p1 = g.players@0, g.players@1
                print(string.format("%d %s %d %.4f %.4f %d %d %d %d", ray.frame(), phase, turn,
                    g.ball.x, g.ball.y, p0.power, p0.angle, p1.power, p1.angle))
            }
        }
    }
    ;; [/trace]

    loop {
        val p = g.players@turn
        ;; aiming, until a click
        watching :fire {
            spawn {
                loop on :frame {
                    if aim(g, p) {
                        emit :fire
                    }
                }
            }
            val d = if p.left => -10 => 10
            loop on :draw {
                ray.triangle(p.x - 10, p.y + d, p.x + 10, p.y - d, p.px, p.py, ray.GRAY)
                ray.triangle(p.x - 10, p.y + d, p.x + 10, p.y - d, p.ax, p.ay, if p.left => ray.DARKBLUE => ray.MAROON)
            }
        }
        ;; the ball, from the next frame on, until it lands
        await :frame
        val ball = g.ball
        val side = if p.left => 1 => -1
        set ball.sx = f32((((side * math.cos(f32(p.pangle*DEG2RAD))) * p.ppower) * 3) / 60)
        set ball.sy = f32((((-math.sin(f32(p.pangle*DEG2RAD))) * p.ppower) * 3) / 60)
        watching :landed {
            spawn {
                loop on :draw {
                    ray.circle(ball.x, ball.y, 10, ray.MAROON)
                }
            }
            loop {
                if fly(g) {
                    emit :landed
                }
                await :frame
            }
        }
        until !(g.players@0).alive || !(g.players@1).alive
        set turn = (turn + 1) % 2
    }
}

;; [trace] of the test mode: the frames out of a game
spawn {
    if ray.frame() > 0 {
        loop on :draw {
            if phase == :over {
                print(string.format("%d %s %d", ray.frame(), phase, turn))
            }
        }
    }
}
;; [/trace]

await Classic(Play)
