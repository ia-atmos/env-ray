;; raylib - classic game: snake
;;
;; Sample game developed by Ian Eito, Albert Martos and Ramon Santamaria.
;; Copyright (c) 2015 Ramon Santamaria (@raysan5), zlib license.
;;
;; Ported to Atmos: an altered version of `classics/src/snake.c` of
;; raysan5/raylib-games. The game is the same; its control is written as
;; sequences: the counter of frames, `gameOver`, `pause`, `allowMove`, and
;; `fruit.active` of the C became awaits and tasks.

include "classic.atm"

val W, H   = 800, 450
val SQUARE = 31
val OX, OY = W % SQUARE, H % SQUARE     ;; the grid is centered: offset/2 at each side

ray.window [title="classic game: snake", width=W, height=H, fps=60]

;; A random cell of the grid, as in the C: x, then y.
func cell () {
    val x = (ray.random(0, (W//SQUARE) - 1) * SQUARE) + (OX/2)
    val y = (ray.random(0, (H//SQUARE) - 1) * SQUARE) + (OY/2)
    [x=x, y=y]
}

func same (a, b) {
    (a.x == b.x) && (a.y == b.y)
}

;; A fruit out of the snake: draws again while it falls on a segment.
func place (snake) {
    loop {
        pin p = cell()
        val hit = loop _,s in snake {
            until same(p, s)
        }
        if !hit {
            break p
        }
    }
}

;; The logic of a game, one step every 5 frames of play. Returns at the end
;; of the game: the snake hit a wall or itself.
task Logic (g) {
    val snake = g.snake
    par :any {
        ;; the snake: the head moves, and each segment takes the place of the
        ;; one before it
        await :frame
        loop {
            val head = snake@0
            vector.insert(snake, 0, [x=head.x+g.speed.x, y=head.y+g.speed.y])
            val tail = vector.remove(snake)
            val h = snake@0
            val wall = (h.x > (W-OX)) || (h.y > (H-OY)) || (h.x < 0) || (h.y < 0)
            val self = loop i in (1, #snake - 1) {
                until same(h, snake@i)
            }
            until wall || self
            emit :moved [tail=tail]
            await(5, :frame)
        }
    } with {
        ;; the fruit: when eaten, the last segment comes back, and the next
        ;; fruit is placed
        loop {
            set g.fruit = place(snake)
            val e = await :moved until same(snake@0, g.fruit)
            vector.insert(snake, e.tail)
        }
    } with {
        ;; the turns: at most one per step, never back
        loop {
            await :moved
            val e = await :key.dn until (match it.name {
                'RIGHT' => g.speed.x == 0
                'LEFT'  => g.speed.x == 0
                'UP'    => g.speed.y == 0
                'DOWN'  => g.speed.y == 0
                else    => false
            })
            set g.speed = match e.name {
                'RIGHT' => [x= SQUARE, y=0]
                'LEFT'  => [x=-SQUARE, y=0]
                'UP'    => [x=0, y=-SQUARE]
                'DOWN'  => [x=0, y= SQUARE]
            }
        }
    }
}

;; One game: its state, its logic, and its drawing. The snake is a vector of
;; segments from the head ([x=,y=]); the state is made anew in each game.
task Play () {
    pin g = [snake=[[x=OX/2, y=OY/2]], fruit=nil, speed=[x=SQUARE, y=0]]
    spawn {
        loop on :draw {
            loop i in (0, W//SQUARE) {
                ray.line_v((SQUARE*i)+(OX/2), OY/2, (SQUARE*i)+(OX/2), H-(OY/2), ray.LIGHTGRAY)
            }
            loop i in (0, H//SQUARE) {
                ray.line_v(OX/2, (SQUARE*i)+(OY/2), W-(OX/2), (SQUARE*i)+(OY/2), ray.LIGHTGRAY)
            }
            loop i,s in g.snake {
                ray.rectangle_v(s.x, s.y, SQUARE, SQUARE, if i==0 => ray.DARKBLUE => ray.BLUE)
            }
            ray.rectangle_v(g.fruit.x, g.fruit.y, SQUARE, SQUARE, ray.SKYBLUE)
        }
    }
    ;; [trace] of the test mode: one line per frame of a game, after its logic
    spawn {
        if ray.frame() > 0 {
            loop on :draw {
                val h = g.snake@0
                print(string.format("%d %s %d %.1f %.1f %.1f %.1f",
                    ray.frame(), phase, #g.snake, h.x, h.y, g.fruit.x, g.fruit.y))
            }
        }
    }
    ;; [/trace]
    await Logic(g)
}

;; [trace] of the test mode: the frames out of a game
spawn {
    if ray.frame() > 0 {
        loop on :draw {
            if phase == :over {
                print(string.format("%d %s", ray.frame(), phase))
            }
        }
    }
}
;; [/trace]

await Classic(Play)
