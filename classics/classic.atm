;; The frame that the classics share, as in their C: the screen is cleared;
;; a game runs, and P pauses it ("GAME PAUSED"); after the game,
;; "PRESS [ENTER] TO PLAY AGAIN" until ENTER, whose frame only starts the
;; next game, as `InitGame` does in the C.
;;
;;      include "classic.atm"
;;      task Play () { ... }        ;; one game, which ends when it is over
;;      await Classic(Play)
;;
;; The pause stops the game but keeps it drawn (`mute <!:draw> ...`).
;;
;; From raylib-games (zlib license): the shared part of the classics.

var phase = :play               ;; :play, :pause, or :over (for the traces)

task Classic (Play) {
    spawn {
        loop on :draw {
            ray.clear(ray.RAYWHITE)
        }
    }
    loop {
        do {
            set phase = :play
            pin play = spawn Play()
            spawn {
                loop {
                    await :key.dn [key='P']
                    mute <!:draw> play(true)
                    set phase = :pause
                    watching :key.dn [key='P'] {
                        val s = "GAME PAUSED"
                        loop on :draw {
                            ray.text(s, (ray.width()//2) - (ray.measure(s,40)//2), (ray.height()//2) - 40, 40, ray.GRAY)
                        }
                    }
                    mute play(false)
                    set phase = :play
                }
            }
            await play
        }
        set phase = :over
        watching :key.dn [key='ENTER'] {
            val s = "PRESS [ENTER] TO PLAY AGAIN"
            loop on :draw {
                ray.text(s, (ray.width()//2) - (ray.measure(s,20)//2), (ray.height()//2) - 50, 20, ray.GRAY)
            }
        }
        await :frame         ;; the frame of ENTER only starts the next game
    }
}
