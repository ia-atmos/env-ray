;; Checks the driver of ray.atm: the order of the events in a frame,
;; key and mouse events, time, polling, and drawing.

ray.window [title="env", width=200, height=100]

spawn {
    loop e on :key.dn {
        print(ray.frame(), "key.dn", e.code, e.key)
    }
}
spawn {
    loop e on :key.up {
        print(ray.frame(), "key.up", e.key, ray.key_down('RIGHT'))
    }
}
spawn {
    loop e on :mouse.button.dn {
        print(ray.frame(), "mouse.dn", e.button, e.x, e.y)
    }
}
spawn {
    await 1s
    print(ray.frame(), "1s")
    await 500ms
    print(ray.frame(), "1.5s")
}
var x = 10
spawn {
    loop on :frame {
        if ray.key_down(ray.KEY.RIGHT) {
            set x += 2
        }
    }
}
spawn {
    loop on :draw {
        ray.clear(ray.RAYWHITE)
        ray.rectangle(x, 10, 20, 20, ray.RED)
        ray.text("env", 5, 80, 10, ray.BLACK)
    }
}
await :quit
print(ray.frame(), "quit", x, ray.random(0,99), ray.random(0,99))
